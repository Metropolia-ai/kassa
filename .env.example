# PayPal REST app credentials (Developer Dashboard -> Apps & Credentials -> Sandbox)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox
# Sandbox test accounts (Developer Dashboard -> Testing Tools -> Sandbox Accounts)
# Business account that owns the app; its email is used as invoicer on outgoing invoices
MERCHANT_EMAIL=sb-xxxx@business.example.com
MERCHANT_NAME=Frappua
# Sandbox personal account email: prefilled as the customer in the 'New invoice' form and the payee of sample bills
DEMO_CUSTOMER_EMAIL=sb-xxxx@personal.example.com
# LLM. Any one of these; leave all empty for the rule-based demo mode.
# OpenRouter (OpenAI-compatible): set the key and a model id from openrouter.ai/models
OPENROUTER_API_KEY=
LLM_MODEL=openai/gpt-6.1-sol
LLM_EXTRACT_MODEL=openai/gpt-6-luna
# or a plain OpenAI-compatible endpoint
OPENAI_API_KEY=
OPENAI_BASE_URL=
# or Anthropic directly
ANTHROPIC_API_KEY=
# Policy
AUTO_PAY_LIMIT=500
CURRENCY=EUR
# Storage: SQLite file by default; set DATABASE_URL (Postgres, e.g. Neon) on Vercel
KASSA_DB=kassa.db
DATABASE_URL=

# Access gate: every /api call needs header X-Kassa-Key=ACCESS_KEY (the page asks for it once).
# Leave empty locally to disable. On Vercel it is required (fail closed).
ACCESS_KEY=
# Vercel Cron sends Authorization: Bearer $CRON_SECRET to /api/refresh
CRON_SECRET=

# Known balance at a point in time; Kassa subtracts its own payouts after it (PayPal snapshot is stale for sandbox)
KASSA_OPENING_BALANCE=
KASSA_OPENING_AT=

