# PayPal REST app credentials (Developer Dashboard -> Apps & Credentials -> Sandbox)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox
# Sandbox test accounts (Developer Dashboard -> Testing Tools -> Sandbox Accounts)
# Business account that owns the app; its email is used as invoicer on outgoing invoices
MERCHANT_EMAIL=sb-xxxx@business.example.com
MERCHANT_NAME=Frappua
# LLM. Any one of these; leave all empty for the rule-based demo mode.
# OpenRouter (OpenAI-compatible): set the key and a model id from openrouter.ai/models
OPENROUTER_API_KEY=
LLM_MODEL=openai/gpt-5-mini
# or a plain OpenAI-compatible endpoint
OPENAI_API_KEY=
OPENAI_BASE_URL=
# or Anthropic directly
ANTHROPIC_API_KEY=
# Policy
AUTO_PAY_LIMIT=500
CURRENCY=EUR
# Storage: SQLite file by default; set DATABASE_URL (Postgres, e.g. Neon) on Vercel
KASSA_DB=kassa.db
DATABASE_URL=
